# Normalise line endings so a Windows checkout and a Linux one produce the same
# bytes. Without this, Git's autocrlf rewrites text files on checkout and the
# vendored Python (a verbatim copy of upstream) stops being verbatim — whose
# local modifications are recorded in THIRD_PARTY_NOTICES.md.

* text=auto eol=lf

# Preserve upstream line endings in vendored files.
vendor/** -text
# Locally patched gateway modules retain upstream CRLF endings.
vendor/workbuddy-gateway/wb_accounts.py whitespace=trailing-space,space-before-tab,cr-at-eol
vendor/workbuddy-gateway/wb_proxy.py whitespace=trailing-space,space-before-tab,cr-at-eol
vendor/workbuddy-gateway/wb_scheduler.py whitespace=trailing-space,space-before-tab,cr-at-eol

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Generated Python bytecode, never tracked.
*.pyc binary
