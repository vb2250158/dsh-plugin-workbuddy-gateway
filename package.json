{
  "name": "dsh-plugin-workbuddy-gateway",
  "version": "0.2.3",
  "description": "WorkBuddy (workbuddy.ai / codebuddy.cn) subscription quota as a DSH model provider: supervises the local OpenAI-compatible gateway and exposes it as a settings page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-plugin-workbuddy-gateway.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-plugin-workbuddy-gateway#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-plugin-workbuddy-gateway/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vendor",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "preflight": "node scripts/spawn-preflight.mjs",
    "verify:boot": "node scripts/verify-platform-boot.mjs",
    "report:reasoning": "node scripts/reasoning-report.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workbuddy",
    "codebuddy",
    "gateway"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
